+import '@testing-library/jest-dom/vitest';
+import {
+	cleanup,
+	fireEvent,
+	render,
+	screen,
+	waitFor,
+} from '@testing-library/react';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+import { CameraPointerControls } from './CameraPointerControls';
+
+afterEach(cleanup);
+
+const labels = {
+	title: 'Camera pointer',
+	toggle: 'Point with the camera',
+	useDotPad: 'Point on the DOT Pad',
+	register: 'Register by corners',
+};
+
+const makeProps = () => ({
+	on: false,
+	statusLabel: 'Off',
+	dotPadConnected: false,
+	useDotPad: true,
+	labels,
+	onToggle: vi.fn(async () => undefined),
+	onToggleUseDotPad: vi.fn(),
+	onRegister: vi.fn(),
+});
+
+describe('CameraPointerControls', () => {
+	it('works without a DOT Pad: toggle and status only while off', async () => {
+		const props = makeProps();
+		render(<CameraPointerControls {...props} />);
+
+		const toggle = screen.getByRole('menuitemcheckbox', {
+			name: labels.toggle,
+		});
+		expect(toggle).toHaveAttribute('aria-checked', 'false');
+		expect(
+			screen.queryByRole('menuitemcheckbox', { name: labels.useDotPad }),
+		).not.toBeInTheDocument();
+		expect(
+			screen.queryByRole('menuitem', { name: labels.register }),
+		).not.toBeInTheDocument();
+		expect(screen.getByRole('status')).toHaveTextContent('Off');
+
+		fireEvent.click(toggle);
+		await waitFor(() => expect(props.onToggle).toHaveBeenCalledTimes(1));
+	});
+
+	it('offers registration while on', () => {
+		const props = { ...makeProps(), on: true, statusLabel: 'Tracking' };
+		render(<CameraPointerControls {...props} />);
+
+		expect(
+			screen.getByRole('menuitemcheckbox', { name: labels.toggle }),
+		).toHaveAttribute('aria-checked', 'true');
+		fireEvent.click(screen.getByRole('menuitem', { name: labels.register }));
+		expect(props.onRegister).toHaveBeenCalledTimes(1);
+		expect(screen.getByRole('status')).toHaveTextContent('Tracking');
+	});
+
+	it('offers the DOT Pad choice only while one is connected', () => {
+		const props = { ...makeProps(), dotPadConnected: true, useDotPad: false };
+		const { rerender } = render(<CameraPointerControls {...props} />);
+
+		const useDotPad = screen.getByRole('menuitemcheckbox', {
+			name: labels.useDotPad,
+		});
+		expect(useDotPad).toHaveAttribute('aria-checked', 'false');
+		fireEvent.click(useDotPad);
+		expect(props.onToggleUseDotPad).toHaveBeenCalledTimes(1);
+
+		rerender(<CameraPointerControls {...props} useDotPad />);
+		expect(
+			screen.getByRole('menuitemcheckbox', { name: labels.useDotPad }),
+		).toHaveAttribute('aria-checked', 'true');
+	});
+
+	it('keeps its actions in the menu arrow-key focus loop', () => {
+		render(
+			<div role="menu">
+				<CameraPointerControls {...makeProps()} on dotPadConnected />
+			</div>,
+		);
+		const toggle = screen.getByRole('menuitemcheckbox', {
+			name: labels.toggle,
+		});
+		const useDotPad = screen.getByRole('menuitemcheckbox', {
+			name: labels.useDotPad,
+		});
+		const register = screen.getByRole('menuitem', { name: labels.register });
+
+		toggle.focus();
+		fireEvent.keyDown(toggle, { key: 'ArrowDown' });
+		expect(useDotPad).toHaveFocus();
+		fireEvent.keyDown(useDotPad, { key: 'ArrowDown' });
+		expect(register).toHaveFocus();
+		fireEvent.keyDown(register, { key: 'ArrowDown' });
+		expect(toggle).toHaveFocus();
+	});
+});
