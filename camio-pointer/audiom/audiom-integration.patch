+
+	it('a late DOT Pad point after switching to rect still maps as a pin', async () => {
+		const { controller, viewport, setPosition } = makeHarness();
+		await controller.start();
+		controller.setSurface('rect');
+		emit('point', {
+			surface: 'dotpad',
