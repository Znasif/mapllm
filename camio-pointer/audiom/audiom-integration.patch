+import { handleHardwareActionKeyDown } from './DotPadControls';
+import styles from './displayOptionsMenu.module.css';
+
+export interface CameraPointerControlLabels {
+	title: string;
+	toggle: string;
+	useDotPad: string;
+	register: string;
+}
+
+export interface CameraPointerControlsProps {
+	/** The camera is on (any phase but off). */
+	on: boolean;
+	statusLabel: string;
+	/** "Point on the DOT Pad" is offered only while one is connected. */
+	dotPadConnected: boolean;
+	useDotPad: boolean;
+	labels: CameraPointerControlLabels;
+	onToggle(): Promise<void>;
+	onToggleUseDotPad(): void;
+	onRegister(): void;
+}
+
+function reportActionError(error: unknown): void {
+	console.error('Camera pointer action failed:', error);
+}
+
+/**
+ * The camera fingertip pointer: on a connected DOT Pad, or on any rectangle
+ * (a printed map) registered by its corners.
+ */
+export function CameraPointerControls({
+	on,
+	statusLabel,
+	dotPadConnected,
+	useDotPad,
+	labels,
+	onToggle,
+	onToggleUseDotPad,
+	onRegister,
+}: CameraPointerControlsProps) {
+	return (
+		<section className={styles.group}>
+			<h3 className={styles.groupTitle}>{labels.title}</h3>
+			<p className={styles.deviceStatus} role="status" aria-live="polite">
+				{statusLabel}
+			</p>
+			<button
+				type="button"
+				className={`${styles.optionItem} ${styles.deviceAction}`}
+				role="menuitemcheckbox"
+				aria-checked={on}
+				onKeyDown={handleHardwareActionKeyDown}
+				onClick={() => {
+					onToggle().catch(reportActionError);
+				}}
+			>
+				{labels.toggle}
+			</button>
+			{dotPadConnected ? (
+				<button
+					type="button"
+					className={`${styles.optionItem} ${styles.deviceAction}`}
+					role="menuitemcheckbox"
+					aria-checked={useDotPad}
+					onKeyDown={handleHardwareActionKeyDown}
+					onClick={onToggleUseDotPad}
+				>
+					{labels.useDotPad}
+				</button>
+			) : null}
+			{on ? (
+				<button
+					type="button"
+					className={`${styles.optionItem} ${styles.deviceAction}`}
+					role="menuitem"
+					onKeyDown={handleHardwareActionKeyDown}
+					onClick={onRegister}
+				>
+					{labels.register}
+				</button>
+			) : null}
+		</section>
+	);
+}
