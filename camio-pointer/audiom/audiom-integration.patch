+			row: 9,
+			u: 0.3,
+			v: 0.2,
+			inBorder: false,
+		});
+		const bounds = tactileWorldBounds(viewport as never);
+		expect(setPosition.mock.calls[0][0]).toEqual([
+			bounds.left + 8.5,
+			bounds.top - 4.5,
+		]);
