 when they try to enter fullscreen mode.
+
+The DOT Pad camera pointer needs the camera inside the iframe, so the generated
+snippet also carries `allow="camera; fullscreen"`. Without `camera` the browser
+refuses the camera and Audiom says so; everything else keeps working. Video is
+processed on the device and never leaves the browser.
diff --git a/src/modules/tactile/camio/createCamioPointer.ts b/src/modules/tactile/camio/createCamioPointer.ts
new file mode 100644
index 0000000..d7c8314
--- /dev/null
+++ b/src/modules/tactile/camio/createCamioPointer.ts
@@ -0,0 +1,116 @@
+import { worldPosition } from '../../../types/coordinates';
+import type {
+	DotPadPointer,
+	PointerStatus,
+} from '../../../vendor/camio/CamioDotPad-0.1.0.js';
+import type { TactileTool } from '../TactileTool';
+import { tactileWorldBounds } from '../viewport';
+
+export type CamioPointerStatus = PointerStatus | { phase: 'off' | 'starting' };
+
+export interface CreateCamioPointerOptions {
+	tactileTool: TactileTool;
+	announce(message: string): void;
+	/** Localise a library prompt code, e.g. t(`camio.prompt.${code}`, { defaultValue }). */
+	translate(code: string, defaultValue: string): string;
+	onStatusChange(status: CamioPointerStatus): void;
+	/** Where public/vendor/mediapipe is served. */
+	assetsBase?: string;
+}
+
+/**
+ * Camera pointer for the DOT Pad: the pin under a pointing fingertip moves the
+ * avatar there. The vendored library (and the bundled MediaPipe JS in it) is a
+ * lazy chunk, loaded only when the pointer is first started; all camera
+ * processing stays on the device.
+ */
+export function createCamioPointer(options: CreateCamioPointerOptions) {
+	const { renderer } = options.tactileTool;
+	let pointer: DotPadPointer | null = null;
+	let loadPromise: Promise<DotPadPointer> | null = null;
+	let deactivate: (() => void) | null = null;
+	let disposed = false;
+
+	const load = () => {
+		loadPromise ??= import(
+			/* webpackChunkName: "camio-dotpad" */ '../../../vendor/camio/CamioDotPad-0.1.0.js'
+		).then(({ createDotPadPointer }) => {
+			if (disposed) throw new Error('Camio pointer was disposed');
+			const created = createDotPadPointer({
+				assetsBase: options.assetsBase ?? '/vendor/mediapipe/',
+				border: renderer.viewport.overlapPins,
+			});
+			created.on('prompt', ({ code, text }) =>
+				options.announce(options.translate(code, text)),
+			);
+			created.on('status', (status) => options.onStatusChange(status));
+			created.on('pin', ({ x, y, inBorder }) => {
+				// The overlap band pages the viewport: a finger resting there must not.
+				if (inBorder) return;
+				const { viewport, world } = renderer;
+				const bounds = tactileWorldBounds(viewport);
+				world.avatar.setPosition(
+					worldPosition(
+						bounds.left + x * viewport.metersPerPin,
+						bounds.top - y * viewport.metersPerPin,
+					),
+				);
+			});
+			pointer = created;
+			return created;
+		});
+		const pending = loadPromise;
+		// A failed chunk load must not stay cached (same as the DOT Pad SDK).
+		pending.catch(() => {
+			if (loadPromise === pending) loadPromise = null;
+		});
+		return pending;
+	};
+
+	const stop = () => {
+		pointer?.stop();
+		deactivate?.();
+		deactivate = null;
+		options.onStatusChange({ phase: 'off' });
+	};
+
+	return {
+		preload: () => {
+			if (disposed) return;
+			load().catch(() => {
+				// A preload failure is silent: start() reports it.
+			});
+		},
+		/** Load, open the camera, and auto-register if not registered yet. */
+		start: async () => {
+			if (disposed) return;
+			options.onStatusChange({ phase: 'starting' });
+			try {
+				const loaded = await load();
+				// Keep the pin frame live while the camera drives the avatar.
+				deactivate ??= renderer.activate();
+				await loaded.start();
+				options.onStatusChange(loaded.status);
+				if (!loaded.registration) void loaded.autoRegister();
+			} catch (error) {
+				stop();
+				throw error;
+			}
+		},
+		stop,
+		get active() {
+			return pointer?.running ?? false;
+		},
+		autoRegister: () => pointer?.autoRegister(),
+		registerByCorners: () => pointer?.registerByCorners(),
+		cancelRegistration: () => pointer?.cancel(),
+		dispose: () => {
+			disposed = true;
+			deactivate?.();
+			deactivate = null;
+			pointer?.dispose();
+			pointer = null;
+			loadPromise = null;
+		},
+	};
+}
diff --git a/src/modules/tactile/camio/createCamioPointer.test.ts b/src/modules/tactile/camio/createCamioPointer.test.ts
new file mode 100644
index 0000000..4701e9b
--- /dev/null
+++ b/src/modules/tactile/camio/createCamioPointer.test.ts
@@ -0,0 +1,131 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import type { TactileTool } from '../TactileTool';
+import { tactileWorldBounds, worldToPin } from '../viewport';
+import { createCamioPointer } from './createCamioPointer';
+
+type Listener = (payload: never) => void;
+
+const mocked = vi.hoisted(() => ({
+	listeners: new Map<string, Listener>(),
+	start: vi.fn(async () => {}),
+	stop: vi.fn(),
+	dispose: vi.fn(),
+	autoRegister: vi.fn(async () => null),
+	registration: null as unknown,
+	options: null as unknown,
+}));
+
+vi.mock('../../../vendor/camio/CamioDotPad-0.1.0.js', () => ({
+	createDotPadPointer: (options: unknown) => {
+		mocked.options = options;
+		return {
+			on: (type: string, listener: Listener) => {
+				mocked.listeners.set(type, listener);
+				return () => {};
+			},
+			start: mocked.start,
+			stop: mocked.stop,
+			dispose: mocked.dispose,
+			autoRegister: mocked.autoRegister,
+			registerByCorners: vi.fn(),
+			cancel: vi.fn(),
+			get registration() {
+				return mocked.registration;
+			},
+			status: { phase: 'idle', tracking: 'none' },
+			running: true,
+		};
+	},
+}));
+
+const emit = (type: string, payload: unknown) =>
+	(mocked.listeners.get(type) as (p: unknown) => void)(payload);
+
+const makeHarness = () => {
+	const viewport = {
+		center: [100, 50],
+		width: 60,
+		height: 40,
+		metersPerPin: 0.5,
+		overlapPins: 2,
+	};
+	const setPosition = vi.fn();
+	const deactivate = vi.fn();
+	const tactileTool = {
+		renderer: {
+			viewport,
+			world: { avatar: { setPosition } },
+			activate: vi.fn(() => deactivate),
+		},
+	} as unknown as TactileTool;
+	const announce = vi.fn();
+	const onStatusChange = vi.fn();
+	const pointer = createCamioPointer({
+		tactileTool,
+		announce,
+		translate: (code, text) => `[${code}] ${text}`,
+		onStatusChange,
+	});
+	return {
+		pointer,
+		viewport,
+		setPosition,
+		deactivate,
+		announce,
+		onStatusChange,
+	};
+};
+
+beforeEach(() => {
+	mocked.listeners.clear();
+	mocked.registration = null;
+	vi.clearAllMocks();
+});
+
+describe('createCamioPointer', () => {
+	it('loads lazily, starts the camera and auto-registers when unregistered', async () => {
+		const { pointer } = makeHarness();
+		expect(mocked.options).toBeNull();
+		await pointer.start();
+		expect(mocked.options).toMatchObject({
+			assetsBase: '/vendor/mediapipe/',
+			border: 2,
+		});
+		expect(mocked.start).toHaveBeenCalledOnce();
+		expect(mocked.autoRegister).toHaveBeenCalledOnce();
+	});
+
+	it('moves the avatar onto the pointed pin (inverse of worldToPin), never in the border', async () => {
+		const { pointer, viewport, setPosition } = makeHarness();
+		await pointer.start();
+		emit('pin', { x: 17, y: 9, inBorder: false });
+		const [position] = setPosition.mock.calls[0];
+		const bounds = tactileWorldBounds(viewport as never);
+		expect(position).toEqual([bounds.left + 17 * 0.5, bounds.top - 9 * 0.5]);
+		expect(worldToPin(position, viewport as never)).toEqual([17, 9]);
+		emit('pin', { x: 1, y: 9, inBorder: true });
+		expect(setPosition).toHaveBeenCalledOnce();
+	});
+
+	it('announces localised prompts and forwards status', async () => {
+		const { pointer, announce, onStatusChange } = makeHarness();
+		await pointer.start();
+		emit('prompt', { code: 'register.done', text: 'DOT Pad registered.' });
+		expect(announce).toHaveBeenCalledWith('[register.done] DOT Pad registered.');
+		emit('status', { phase: 'ready', tracking: 'tracking' });
+		expect(onStatusChange).toHaveBeenLastCalledWith({
+			phase: 'ready',
+			tracking: 'tracking',
+		});
+	});
+
+	it('stop and dispose release the camera and the renderer', async () => {
+		const { pointer, deactivate } = makeHarness();
+		await pointer.start();
+		pointer.stop();
+		expect(mocked.stop).toHaveBeenCalled();
+		expect(deactivate).toHaveBeenCalledOnce();
+		pointer.dispose();
+		expect(mocked.dispose).toHaveBeenCalledOnce();
+	});
+});
