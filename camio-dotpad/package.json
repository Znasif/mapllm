{
  "name": "camio-dotpad",
  "version": "0.1.0",
  "private": true,
  "description": "Camera fingertip pointer for the DOT Pad: registers the 60x40 pin field from the camera, tracks it without OpenCV, and emits the pin under a pointing fingertip.",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:tracker": "vitest run test/tracker.sequences.test.ts",
    "typecheck": "tsc --noEmit",
    "demo": "vite --config demo/vite.config.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.4",
    "@mediapipe/tasks-vision": "0.10.35",
    "@types/node": "^22.20.4",
    "dts-bundle-generator": "^9.5.1",
    "esbuild": "0.25.5",
    "jpeg-js": "^0.4.4",
    "jsdom": "^26.1.0",
    "typescript": "5.8.3",
    "vite": "^6.3.5",
    "vitest": "3.2.7"
  }
}
